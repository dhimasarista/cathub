# Connection string for the Vault (Postgres / MySQL / SQLite).
# Leave unset or empty to run CatHub in No-DB Mode (broadcast-only, no persistence).
#
# Examples:
#   DATABASE_URL=postgres://user:password@localhost:5432/cathub
#   DATABASE_URL=mysql://user:password@localhost:3306/cathub
#   DATABASE_URL=sqlite://cathub.db
DATABASE_URL=

# Log verbosity for the `tracing` subscriber (error, warn, info, debug, trace).
RUST_LOG=info
